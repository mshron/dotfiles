#!/usr/bin/env bash
# mark — live markdown preview in the browser via Vivify (live reload,
# KaTeX, syntax highlighting), plus a click-to-comment sidecar that writes
# reviewer feedback to <file>.comments.md.
#
# Servers auto-start if down. Vivify's idle timeout is set long (24h, see
# ~/.config/vivify/config.json) so the preview URL survives suspended panes.
#
# Works on macOS and Linux. Reads ~/.config/vivify/mark.conf for
# MARK_LOCATION (local, the default, or remote — see setup.sh). In remote
# mode there's no local display to open a browser on, so mark always just
# prints the URL, built from this host's Tailscale address instead of
# localhost.

no_open=0
if [[ $1 == --no-open ]]; then
  no_open=1
  shift
fi

if [[ -z $1 || ! -f $1 ]]; then
  echo "usage: mark [--no-open] <file.md>" >&2
  exit 1
fi

if [[ -z ${MARK_LOCATION:-} && -f "$HOME/.config/vivify/mark.conf" ]]; then
  . "$HOME/.config/vivify/mark.conf"
fi
location=${MARK_LOCATION:-local}

port=${VIV_PORT:-31622}

if [[ $location == remote ]]; then
  host=$(tailscale ip -4 2>/dev/null)
  if [[ -z $host ]]; then
    echo "mark: MARK_LOCATION=remote but \`tailscale ip -4\` returned nothing — is tailscaled running and this host joined to a tailnet?" >&2
    exit 1
  fi
  no_open=1
elif [[ $location != local ]]; then
  echo "mark: unknown MARK_LOCATION '$location' (expected local or remote)" >&2
  exit 1
else
  host=localhost
fi

url="http://${host}:${port}/viewer$(realpath "$1")"

# Detach into a new session/process group (setsid via node), not just nohup:
# agent harnesses (e.g. Codex) kill the command's whole process group when the
# call returns, which would take the servers down with it.
detach() {
  node -e 'const{spawn}=require("child_process");spawn(process.argv[1],process.argv.slice(2),{detached:true,stdio:"ignore"}).unref()' "$@"
}

if ! curl -sf -o /dev/null --max-time 1 "http://localhost:${port}/health"; then
  detach vivify-server
  for _ in {1..30}; do
    curl -sf -o /dev/null --max-time 1 "http://localhost:${port}/health" && break
    sleep 0.1
  done
fi

if ! curl -sf -o /dev/null --max-time 1 "http://localhost:${VIV_COMMENTS_PORT:-31623}/health"; then
  detach node ~/.config/vivify/comments-server.mjs
fi

if (( no_open )); then
  # caller opens the URL itself (e.g. an agent with an in-app browser), or
  # there's no local display to open one on (remote mode)
  :
elif [[ -x $CMUX_BUNDLED_CLI_PATH ]]; then
  # Keep the preview in the workspace that launched mark without changing focus.
  workspace_args=()
  [[ -n ${CMUX_WORKSPACE_ID:-} ]] && workspace_args=(--workspace "$CMUX_WORKSPACE_ID")
  "$CMUX_BUNDLED_CLI_PATH" browser open "$url" "${workspace_args[@]}" --focus false >/dev/null
elif command -v open >/dev/null 2>&1; then
  open "$url"
elif command -v xdg-open >/dev/null 2>&1; then
  xdg-open "$url" >/dev/null 2>&1 &
fi

echo "$url"
