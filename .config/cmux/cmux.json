  "shortcuts": {
    "bindings": {
      // Splits — tmux: prefix | / prefix -
      "splitRight": ["ctrl+space", "shift+\\"],
      "splitDown": ["ctrl+space", "-"],

      // Pane focus — tmux: prefix h/j/k/l
      "focusLeft": ["ctrl+space", "h"],
      "focusDown": ["ctrl+space", "j"],
      "focusUp": ["ctrl+space", "k"],
      "focusRight": ["ctrl+space", "l"],

      // Pane zoom & equalize — tmux: prefix z
      "toggleSplitZoom": ["ctrl+space", "z"],
      "equalizeSplits": ["ctrl+space", "="],

      // Copy mode — tmux: prefix [
      "toggleTerminalCopyMode": ["ctrl+space", "["],

      // Surfaces/tabs — tmux: prefix x/,  (newSurface/nextSurface/prevSurface left at defaults: cmd+t / cmd+shift+] / cmd+shift+[)
      "closeTab": ["ctrl+space", "x"],
      "renameTab": ["ctrl+space", ","],

      // Select surface by number — tmux: prefix 1-9
      "selectSurface1": ["ctrl+space", "1"],
      "selectSurface2": ["ctrl+space", "2"],
      "selectSurface3": ["ctrl+space", "3"],
      "selectSurface4": ["ctrl+space", "4"],
      "selectSurface5": ["ctrl+space", "5"],
      "selectSurface6": ["ctrl+space", "6"],
      "selectSurface7": ["ctrl+space", "7"],
      "selectSurface8": ["ctrl+space", "8"],
      "selectSurface9": ["ctrl+space", "9"],

      // Workspaces (tmux sessions) — tmux: prefix s / $ / ( / )
      "goToWorkspace": ["ctrl+space", "s"],
      "renameWorkspace": ["ctrl+space", "shift+4"],
      "previousWorkspace": ["ctrl+space", "shift+9"],
      "nextWorkspace": ["ctrl+space", "shift+0"],
      "closeWorkspace": ["ctrl+space", "shift+x"],

      // Command palette — tmux: prefix : (command mode)
      "commandPalette": ["ctrl+space", "shift+;"],

      // Reload config — tmux: prefix r
      "reloadConfiguration": ["ctrl+space", "r"]
    }
  }
}
